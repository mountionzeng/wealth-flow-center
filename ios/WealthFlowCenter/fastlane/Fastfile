default_platform(:ios)

platform :ios do
  desc "Build the App Store archive after Xcode signing is configured"
  lane :build_release do
    build_app(
      project: "WealthFlowCenter.xcodeproj",
      scheme: "WealthFlowCenter",
      export_method: "app-store"
    )
  end

  desc "Upload metadata and build to App Store Connect"
  lane :release do
    build_release
    upload_to_app_store(
      submit_for_review: false,
      automatic_release: false,
      force: true
    )
  end
end
