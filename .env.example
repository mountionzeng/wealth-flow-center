# Copy these values to ~/Library/Application Support/Berich/config.env.
# Both manual and launchd starts read that ignored, user-owned file. Never commit real values.
BERICH_AI_PROVIDER_NAME=your-provider
BERICH_AI_BASE_URL=https://provider.example/v1
BERICH_AI_API_KEY=replace-me
BERICH_AI_TEXT_MODEL=replace-me
BERICH_AI_VISION_MODEL=replace-me
BERICH_AI_RETENTION_POLICY=verify-with-provider-before-use
BERICH_AI_TERMS_VERSION=replace-me
BERICH_AI_TIMEOUT_SECONDS=45
