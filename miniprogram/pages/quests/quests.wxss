.qc {
  margin-bottom: 20rpx;
  padding: 24rpx 28rpx;
  position: relative;
}
.qc-done { opacity: .65; }
.qc-over { border-left: 4rpx solid var(--red); }

.qc-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  border-radius: 24rpx 0 0 24rpx;
}
.qc-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.qc-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
  border: 1rpx solid currentColor;
  opacity: .85;
}
.qc-titles { flex: 1; }
.qc-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
}
.qc-course {
  font-size: 22rpx;
  color: var(--t3);
  margin-top: 4rpx;
  display: block;
}
.qc-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}
.qc-time { font-size: 22rpx; color: var(--t3); }
.qc-rwds { display: flex; gap: 10rpx; }
.rwd {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 600;
}
.rwd-xp  { background: rgba(196,150,14,.12); color: #8a6008; }
.rwd-w   { background: rgba(58,110,72,.12);  color: #3a6e48; }

.qc-row2 {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.st-chip {
  font-size: 20rpx;
  padding: 3rpx 14rpx;
  border-radius: 14rpx;
}
.st-active   { background: rgba(196,150,14,.14); color: #8a6008; }
.st-upcoming { background: rgba(80,140,190,.12); color: #2c5878; }
.st-overdue  { background: rgba(160,56,40,.12);  color: #a03828; }
.st-done     { background: rgba(58,110,72,.12);  color: #3a6e48; }

.cd { font-size: 22rpx; }
.cd-soon { color: var(--blue); }
.cd-live { color: var(--green); font-weight: 600; }
.cd-over { color: var(--t4); }
.cd-done { color: var(--green); }

.qc-actions { display: flex; gap: 16rpx; }
.btn-a {
  flex: 1;
  padding: 16rpx 0;
  font-size: 24rpx;
  border-radius: 16rpx;
  border: none;
  font-weight: 600;
  line-height: 1;
}
.btn-done { background: rgba(58,110,72,.14);  color: #3a6e48; }
.btn-edit { background: rgba(80,140,190,.12); color: #2c5878; }
.btn-del  { background: rgba(160,56,40,.1);  color: #a03828; }

.form-tag-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.form-tag-title {
  margin-bottom: 0;
}
.form-tag-hint {
  color: var(--t4);
  font-size: 22rpx;
  line-height: 32rpx;
}
.form-tag-scroll {
  width: 100%;
  white-space: nowrap;
  margin-top: 12rpx;
}
.form-tag-row {
  display: flex;
  gap: 14rpx;
  padding-bottom: 4rpx;
}
.form-tag-chip {
  width: 240rpx;
  min-height: 122rpx;
  flex-shrink: 0;
  border: 1rpx solid rgba(190, 148, 55, .24);
  border-radius: 18rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
}
.form-tag-badge {
  display: block;
  font-size: 20rpx;
  line-height: 28rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
}
.form-tag-name {
  display: block;
  max-width: 208rpx;
  color: var(--text);
  font-size: 25rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 600;
}
.form-tag-meta {
  display: block;
  max-width: 208rpx;
  color: var(--t3);
  font-size: 21rpx;
  line-height: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 4rpx;
}
