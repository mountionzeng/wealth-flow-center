.day-block { margin-bottom: 24rpx; }
.day-hdr {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
  border-bottom: 1rpx solid rgba(190, 148, 55, .14);
  margin-bottom: 16rpx;
}
.day-name { font-size: 28rpx; font-weight: 700; color: var(--gold); }
.day-date { font-size: 22rpx; color: var(--t3); }
.day-empty { font-size: 24rpx; color: var(--t4); font-style: italic; padding: 8rpx 0; }

.day-task {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 251, 232, .7);
  border-radius: 16rpx;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}
.day-time { font-size: 22rpx; color: var(--t3); flex-shrink: 0; }
.day-st {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.day-st.done     { background: rgba(58,110,72,.12); color: #3a6e48; }
.day-st.active   { background: rgba(196,150,14,.14); color: #8a6008; }
.day-st.upcoming { background: rgba(80,140,190,.12); color: #2c5878; }
.day-course { font-size: 22rpx; color: var(--t3); }
.day-ttl { font-size: 26rpx; font-weight: 600; color: var(--text); }
