/* ── 全局变量 ─────────────────────────────────────────── */
page {
  --card: rgba(255, 251, 232, .94);
  --gold: #9a7010;
  --gold2: #c4960e;
  --gold3: #e8be40;
  --text: #2a1c06;
  --t2: #705830;
  --t3: #a08448;
  --t4: #c4a868;
  --red: #a03828;
  --green: #3a6e48;
  --blue: #2c5878;
  --r: 16rpx;
  --rs: 10rpx;
  background-color: #fdf6df;
  font-family: 'PingFang SC', system-ui, sans-serif;
  font-size: 28rpx;
  color: #2a1c06;
}

/* ── 卡片 ─────────────────────────────────────────────── */
.gc {
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 32rpx rgba(160, 120, 40, .09), 0 2rpx 8rpx rgba(160, 120, 40, .06);
  position: relative;
  overflow: hidden;
}

/* ── 段落标题 ─────────────────────────────────────────── */
.sh {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  margin-top: 32rpx;
}
.sh-text {
  font-size: 26rpx;
  color: var(--gold);
  letter-spacing: 2rpx;
  font-weight: 600;
}
.sh-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(190, 148, 55, .24), transparent);
}

/* ── 页面通用容器 ──────────────────────────────────────── */
.page-wrap {
  min-height: 100vh;
  background: #fdf6df;
  padding: 20rpx 24rpx 140rpx;
}

/* ── 顶栏 ────────────────────────────────────────────── */
.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(253, 246, 223, .95);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid rgba(190, 148, 55, .14);
}
.topbar-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.topbar-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gold);
}
.topbar-stats {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.tstat {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--t2);
}
.tstat-val {
  font-weight: 700;
  color: var(--gold2);
  font-size: 28rpx;
}
.tstat-lbl {
  font-size: 22rpx;
  color: var(--t3);
}

/* ── 空状态 ──────────────────────────────────────────── */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--t3);
  font-size: 28rpx;
  line-height: 1.8;
}
.empty-line {
  display: block;
}

/* ── Toast ──────────────────────────────────────────── */
.toast {
  position: fixed;
  top: 40%;
  left: 50%;
  transform: translateX(-50%);
  padding: 20rpx 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  z-index: 9999;
  pointer-events: none;
}
.toast.s { background: rgba(58, 110, 72, .92); color: #fff; }
.toast.e { background: rgba(160, 56, 40, .92); color: #fff; }

/* ── 弹窗遮罩 ─────────────────────────────────────────── */
.ovl {
  position: fixed;
  inset: 0;
  background: rgba(30, 18, 4, .38);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

/* ── 底部表单抽屉 ─────────────────────────────────────── */
.sheet {
  width: 100%;
  background: #fffbf0;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 32rpx 60rpx;
  max-height: 88vh;
  overflow-y: auto;
}
.sh-handle {
  width: 72rpx;
  height: 8rpx;
  background: rgba(160, 132, 72, .25);
  border-radius: 4rpx;
  margin: 20rpx auto 0;
}
.sh-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--gold);
  text-align: center;
  padding: 24rpx 0 20rpx;
}

/* ── 表单元素 ─────────────────────────────────────────── */
.fg { margin-bottom: 26rpx; }
.fl {
  display: block;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--t3);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}
.fi {
  width: 100%;
  height: 76rpx;
  min-height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(190, 148, 55, .28);
  border-radius: 16rpx;
  background: rgba(255, 250, 232, .86);
  color: var(--text);
  font-size: 28rpx;
  box-sizing: border-box;
}
.fsel-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(190, 148, 55, .28);
  border-radius: 16rpx;
  background: rgba(255, 250, 232, .86);
  font-size: 28rpx;
  color: var(--text);
}
.fsel-arrow { color: var(--t3); font-size: 24rpx; }
.frow { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }

/* ── 按钮 ────────────────────────────────────────────── */
.btn-sub {
  width: 100%;
  padding: 28rpx;
  background: linear-gradient(100deg, var(--gold), var(--gold2), var(--gold3));
  border: none;
  border-radius: 20rpx;
  color: #fff8e8;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}
.btn-sub[disabled] { opacity: .5; }
.btn-can {
  width: 100%;
  padding: 22rpx;
  background: transparent;
  border: 1rpx solid rgba(190, 148, 55, .28);
  border-radius: 20rpx;
  color: var(--t2);
  font-size: 28rpx;
  margin-top: 16rpx;
}

/* ── FAB ─────────────────────────────────────────────── */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: linear-gradient(135deg, var(--gold2), var(--gold3));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(196, 150, 14, .45);
  z-index: 50;
  border: none;
  font-size: 52rpx;
  color: #fff8e8;
  font-weight: 300;
  line-height: 1;
}

/* ── 确认对话框 ───────────────────────────────────────── */
.covl {
  position: fixed;
  inset: 0;
  background: rgba(30, 18, 4, .45);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cbox {
  background: #fffbf0;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 36rpx;
  width: 580rpx;
}
.c-ttl {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 16rpx;
  text-align: center;
}
.c-body {
  font-size: 28rpx;
  color: var(--t2);
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.6;
}
.c-btns { display: flex; gap: 20rpx; }
.c-yes {
  flex: 1;
  padding: 24rpx;
  background: var(--red);
  border: none;
  border-radius: 16rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.c-no {
  flex: 1;
  padding: 24rpx;
  background: transparent;
  border: 1rpx solid rgba(190, 148, 55, .3);
  border-radius: 16rpx;
  color: var(--t2);
  font-size: 28rpx;
}

/* ── 图表条形 ─────────────────────────────────────────── */
.bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.bar-lbl {
  font-size: 22rpx;
  color: var(--t2);
  min-width: 80rpx;
  text-align: right;
  flex-shrink: 0;
}
.bar-track {
  flex: 1;
  height: 16rpx;
  background: rgba(160, 120, 40, .08);
  border-radius: 8rpx;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  border-radius: 8rpx;
  min-width: 4rpx;
}
.bar-val {
  font-size: 22rpx;
  color: var(--t3);
  min-width: 64rpx;
  flex-shrink: 0;
}
